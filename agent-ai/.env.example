# ============================================================================
# AgentAI environment configuration template
# Copy to .env and fill in secrets. Never commit .env.
# ============================================================================

# ---- Core ----
APP_ENV=development
APP_NAME=agent-ai
DEBUG=true
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
SECRET_KEY=change-me-to-a-long-random-string
ALEMBIC_SKIP=0

# ---- Public site under crawl ----
DEFAULT_SOURCE_URL=https://www.tryvium.ai
DEFAULT_SITEMAP_URL=https://www.tryvium.ai/sitemap_index.xml

# ---- Postgres ----
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=agentai
POSTGRES_USER=agentai
POSTGRES_PASSWORD=agentai
DATABASE_URL=postgresql+asyncpg://agentai:agentai@postgres:5432/agentai

# ---- Redis ----
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://redis:6379/0
REDIS_QUEUE_URL=redis://redis:6379/1

# ---- Qdrant ----
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=

# ---- Object storage ----
STORAGE_BACKEND=local            # local | s3 | azure | gcs
STORAGE_LOCAL_DIR=data/storage
S3_ENDPOINT_URL=
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=
AZURE_CONNECTION_STRING=
AZURE_CONTAINER=
GCS_BUCKET=
GCS_CREDENTIALS_PATH=

# ---- Embedding provider ----
EMBEDDING_PROVIDER=fastembed      # fastembed | openai | azure | huggingface | vertex
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024
EMBEDDING_BATCH_SIZE=32
EMBEDDING_MAX_CHARS=8192
EMBEDDING_CACHE_TTL=86400

# ---- Reranker ----
RERANKER_PROVIDER=fastembed
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# ---- LLM gateway ----
LLM_DEFAULT_PROVIDER=openai       # openai | anthropic | azure | gemini | mistral | groq | ollama | local
LLM_DEFAULT_MODEL=gpt-4o-mini
LLM_FAST_MODEL=gpt-4o-mini        # cheap model for classification / small tasks
LLM_REASONING_MODEL=o3-mini       # deep-thinking model for complex queries
LLM_TIMEOUT_SECONDS=120
LLM_MAX_TOKENS=1500
LLM_TEMPERATURE=0.2

OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_ORG_ID=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-large-latest
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
AZURE_OPENAI_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.1
LOCAL_MODEL_PATH=

# ---- Retrieval ----
RETRIEVAL_TOP_K=24
RETRIEVAL_RERANK_TOP_K=8
RETRIEVAL_RRF_K=60
RETRIEVAL_MIN_SCORE=0.35
RETRIEVAL_CONFIDENCE_THRESHOLD=0.55
RETRIEVAL_SEMANTIC_WEIGHT=1.0
RETRIEVAL_KEYWORD_WEIGHT=1.0
RETRIEVAL_MMR_LAMBDA=0.7
RETRIEVAL_MMR_TOP_K=40

# ---- Search modes ----
SEARCH_USE_KNOWLEDGE_GRAPH=true
SEARCH_USE_MULTI_QUERY=true
SEARCH_USE_QUERY_REWRITE=true
SEARCH_USE_CONTEXT_COMPRESSION=true

# ---- Caching ----
CACHE_ENABLED=true
CACHE_RETRIEVAL_TTL=900
CACHE_QUERY_TTL=300
CACHE_RESPONSE_TTL=300
CACHE_EMBEDDING_TTL=86400
CACHE_MAX_RESPONSES=5000

# ---- Crawler ----
CRAWLER_CONCURRENCY=16
CRAWLER_RESPECT_ROBOTS=true
CRAWLER_USER_AGENT=AgentAI-Crawler/1.0 (+https://www.tryvium.ai/bot)
CRAWLER_REQUEST_TIMEOUT=30
CRAWLER_MAX_RETRIES=4
CRAWLER_RETRY_BASE_DELAY=2
CRAWLER_MAX_PAGES_PER_RUN=100000
CRAWLER_DOWNLOAD_BINARIES=true

# ---- Ingestion ----
CHUNK_STRATEGY=heading            # heading | semantic | fixed
CHUNK_MIN_CHARS=600
CHUNK_MAX_CHARS=1600
CHUNK_OVERLAP_CHARS=120
PARSER_MAX_DOC_SIZE_MB=20
OCR_ENABLED=true
OCR_TESSERACT_PATH=tesseract
VIDEO_TRANSCRIPTION_ENABLED=false

# ---- Workers ----
CELERY_BROKER_URL=redis://redis:6379/2
CELERY_RESULT_BACKEND=redis://redis:6379/3
CELERY_MAX_RETRIES=5
DLQ_RETRY_BEFORE_DEAD=3
WORKER_CONCURRENCY=4

# ---- Webhooks ----
WEBHOOK_SECRET=change-me-webhook-secret

# ---- Security ----
JWT_SECRET=change-me-jwt-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TTL_MINUTES=30
JWT_REFRESH_TTL_DAYS=14
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_CHAT_PER_MINUTE=20
AUTH_PROVIDER=internal            # internal | oauth
PII_SCANNER_ENABLED=true
PROMPT_INJECTION_SCANNER_ENABLED=true

# ---- Observability ----
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_SERVICE_NAME=agentai-api
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
METRICS_ENABLED=true
