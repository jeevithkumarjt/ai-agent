# Copy to .env and fill real values (ADR-007: secrets via environment only).
# Never commit .env.

APP_ENV=development
DEBUG=false

# --- Database (ADR-001) ---
DATABASE_URL=postgresql+asyncpg://agentai:agentai@localhost:5432/agentai

# --- LLM (Anthropic) ---
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_VERSION=2023-06-01
ANTHROPIC_MODEL=claude-sonnet-4-5
ANTHROPIC_MAX_TOKENS=2048

# --- Embeddings (must produce vector(1536)) ---
# Leave EMPTY in development to use the local hash fallback (dev-only, meaningless retrieval).
EMBEDDINGS_API_KEY=
EMBEDDINGS_BASE_URL=https://api.openai.com/v1
EMBEDDINGS_MODEL=text-embedding-3-small
EMBEDDINGS_DIM=1536
EMBEDDINGS_BATCH_SIZE=64

# --- Retrieval ---
RETRIEVAL_TOP_K=5

# --- Agent loop guardrails (02-agent-and-rag-workflow.md) ---
AGENT_MAX_TOOL_ITERATIONS=5

# --- Auth (ADR-005) ---
JWT_SECRET=change-me-to-a-long-random-string-32+chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TTL_MINUTES=30
JWT_REFRESH_TTL_DAYS=14

# --- Bootstrap (python -m backend.cli seed) ---
BOOTSTRAP_TENANT_NAME=Default
BOOTSTRAP_OWNER_EMAIL=owner@example.com
BOOTSTRAP_OWNER_PASSWORD=ChangeMe123!
