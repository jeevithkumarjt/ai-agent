# Copy to .env and fill real values (ADR-007: secrets via environment only).
# Never commit .env.

APP_ENV=development
DEBUG=false

# --- Database (ADR-001) ---
DATABASE_URL=postgresql+asyncpg://agentai:agentai@localhost:5432/agentai

# --- LLM provider: "anthropic" | "groq" ---
# Switching providers is a config-only change (ADR-002: the orchestrator is
# provider-agnostic; the Groq path talks to an OpenAI-compatible endpoint).
#   Groq (free tier, fast):
#     LLM_PROVIDER=groq
#     GROQ_API_KEY=gsk_...
#     (GROQ_BASE_URL / GROQ_MODEL default to Groq; GROQ_* win over ANTHROPIC_*)
#   Anthropic (native Messages API):
#     LLM_PROVIDER=anthropic
#     ANTHROPIC_API_KEY=sk-ant-...
#     ANTHROPIC_BASE_URL=https://api.anthropic.com
#     ANTHROPIC_MODEL=claude-sonnet-4-5
LLM_PROVIDER=groq

# --- LLM endpoint (Groq / OpenAI-compatible; used when LLM_PROVIDER=groq) ---
# NOTE: the same key block doubles as the LLM endpoint when LLM_PROVIDER=groq:
# ANTHROPIC_API_KEY / ANTHROPIC_BASE_URL / ANTHROPIC_MODEL below hold the Groq
# values (see .env). Available Groq models include openai/gpt-oss-120b,
# qwen/qwen3.8-27b, openai/gpt-oss-20b, allam-2-7b, groq/compound-mini.
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b

# --- LLM endpoint (Anthropic; used when LLM_PROVIDER=anthropic) ---
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_VERSION=2023-06-01
ANTHROPIC_MODEL=openai/gpt-oss-120b
ANTHROPIC_MAX_TOKENS=2048

# --- LLM failover (optional, no extra cost) ---
# Second free-tier Groq model used for ONE best-effort attempt after the primary
# exhausts retries (429 / 5xx / timeout / empty response). If this also fails the
# client degrades gracefully to a "temporarily unavailable, please retry" message.
LLM_FALLBACK_MODEL=llama-3.3-70b-versatile

# --- Embeddings (must produce vector(768) when using Ollama) ---
# REQUIRED for real RAG. When unset, vector retrieval AND ingestion are
# disabled (hash-fallback vectors are meaningless and can never be written to
# the store or queried — they are only usable for offline dev smoke tests).
# Use an OpenAI-compatible /v1/embeddings endpoint, e.g. Ollama running on
# the Docker host at http://host.docker.internal:11434/v1 with:
#   EMBEDDINGS_API_KEY=ollama
#   EMBEDDINGS_BASE_URL=http://host.docker.internal:11434/v1
EMBEDDINGS_API_KEY=
EMBEDDINGS_BASE_URL=http://host.docker.internal:11434/v1
EMBEDDINGS_MODEL=nomic-embed-text
EMBEDDINGS_DIM=768
EMBEDDINGS_BATCH_SIZE=64

# --- Retrieval (hybrid: Postgres ts_rank + pgvector cosine in one query) ---
RETRIEVAL_TOP_K=8
# Blend applied to the final score: lexical ts_rank * LEX + vector cosine * VEC.
# Sum should be 1.0. Higher LEX favors exact keyword matches (tsvector GIN).
RETRIEVAL_LEXICAL_WEIGHT=0.3
RETRIEVAL_VECTOR_WEIGHT=0.7

# --- Knowledge store (extracts documents/ + site crawl into document_chunks) ---
KNOWLEDGE_DOCS_DIR=documents
KNOWLEDGE_SITES=https://www.tryvium.ai/
KNOWLEDGE_MAX_SITE_PAGES=80
KNOWLEDGE_REFRESH_MINUTES=360

# --- Agent loop guardrails (02-agent-and-rag-workflow.md) ---
AGENT_MAX_TOOL_ITERATIONS=5

# --- Multi-agent routing (LangGraph supervisor + specialists) ---
# true  = LangGraph StateGraph: supervisor routes to knowledge/support/sales/chat
#         specialists (more LLM calls per turn; best on paid Groq tier)
# false = single-agent tool loop (fewer LLM calls, free-tier friendly)
USE_LANGGRAPH=false

# --- Auth (ADR-005) ---
JWT_SECRET=change-me-to-a-long-random-string-32+chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TTL_MINUTES=30
JWT_REFRESH_TTL_DAYS=14

# --- Anonymous guest sessions (public chat pages) ---
# Issues scoped, rate-limited demo tokens server-side — no credentials shipped
# to browsers. Anonymous visitors can chat immediately; past GUEST_MESSAGE_LIMIT
# the API returns 403 guest_message_limit_reached and clients gate on sign-in.
#   GUEST_ENABLED=true      enable anonymous demo chat (default false in a strict deployment)
#   GUEST_ROLE=viewer       role granted to anonymous sessions
#   GUEST_TENANT_ID=        optional; leave empty to use the first tenant
GUEST_ENABLED=true
GUEST_ROLE=viewer
GUEST_TENANT_ID=
GUEST_SESSION_TTL_MINUTES=30
GUEST_MESSAGE_LIMIT=10

# --- Rate limits (in-memory sliding windows; ADR-008 seam) ---
# Guests (role == GUEST_ROLE) are limited per session AND per IP; authenticated
# users get higher per-session limits. Responses are 429 + Retry-After.
# GUEST_REQUESTS_PER_MINUTE also feeds the newer limiter (kept for compat).
GUEST_REQUESTS_PER_MINUTE=20
GUEST_DAILY_REQUESTS=200
# Token-issuance guard on POST /v1/auth/guest (each call persists a user row).
GUEST_ISSUANCE_PER_MINUTE=12
GUEST_ISSUANCE_DAILY=500
AUTH_REQUESTS_PER_MINUTE=60
AUTH_DAILY_REQUESTS=2000

# --- Caching (ADR-008 seam; no extra dependency by default) ---
# memory = in-process TTL cache (default; single uvicorn worker)
# redis  = multi-worker; set CACHE_REDIS_URL + install redis-py in the image.
#          If Redis is missing/unreachable the cache falls back to memory silently.
CACHE_BACKEND=memory
CACHE_REDIS_URL=
CACHE_RAG_TTL_SECONDS=600
CACHE_RAG_MAXSIZE=1024

# --- Bootstrap (python -m backend.cli seed) ---
BOOTSTRAP_TENANT_NAME=Default
BOOTSTRAP_OWNER_EMAIL=owner@example.com
BOOTSTRAP_OWNER_PASSWORD=ChangeMe123!

# --- CORS (comma-separated; default allows localhost + GitHub Pages) ---
CORS_ORIGINS=https://jeevithkumarjt.github.io
